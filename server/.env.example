# Environment Mode
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL & pgvector Configuration
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:your_password@db.your-supabase-project-ref.supabase.co:5432/postgres

# Security & JWT Token Configuration
JWT_SECRET=your_strong_production_jwt_secret_key
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Vercel Production Frontend)
CLIENT_URL=https://campusgpt.vercel.app

# RAG & Google Gemini Production Configuration
GEMINI_API_KEY=AIzaSy_your_production_gemini_api_key
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.0-flash
RAG_SIMILARITY_THRESHOLD=0.65
TOP_K=4
ENABLE_DETERMINISTIC_EMBEDDING_FALLBACK=false
